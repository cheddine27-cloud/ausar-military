# Supabase Configuration
# احصل على هذه المفاتيح من: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ملاحظات:
# 1. انسخ هذا الملف وسمّه .env
# 2. ضع مفاتيحك الحقيقية في ملف .env
# 3. لا ترفع ملف .env على GitHub أبداً!
# 4. تأكد من إضافة .env إلى ملف .gitignore الخاص بك


VITE_APP_NAME=Ausar Military
VITE_SUPER_ADMIN_USERNAME=ausar_admin
